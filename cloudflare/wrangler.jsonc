{
  "name": "ecbs-hotelsuite",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "containers": [
    {
      "class_name": "EcbsApp",
      "image": "../Dockerfile",
      "image_build_context": "..",
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "durable_objects": { "bindings": [{ "name": "ECBS", "class_name": "EcbsApp" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["EcbsApp"] }],
  // 02:35 UTC = 05:35 Nairobi: wakes the server so nightly room billing posts
  "triggers": { "crons": ["35 2 * * *"] },
  "vars": { "TZ": "Africa/Nairobi" },
  // Addresses served by this app. Each one must be a hostname on your Cloudflare domain.
  // ONLY these hostnames reach the app, so your other systems on ettylinks-tech.co.ke are untouched.
  // To add a client address later: add one line here, commit on GitHub, it deploys itself.
  "routes": [
    { "pattern": "platform.ettylinks-tech.co.ke", "custom_domain": true },
    { "pattern": "hotelsuite.ettylinks-tech.co.ke", "custom_domain": true }
  ],
  // do not expose the app on *.workers.dev
  "workers_dev": false,
  "preview_urls": false
}
